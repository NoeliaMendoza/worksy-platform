# Copia este archivo como .env y cambia TODOS los valores antes de usarlo.
# Estos valores son solo para desarrollo local. Nunca subas el .env al repositorio.

# PostgreSQL
POSTGRES_DB=empleo
POSTGRES_USER=empleo
POSTGRES_PASSWORD=cambia-esto-postgres

# RabbitMQ
RABBITMQ_DEFAULT_USER=empleo
RABBITMQ_DEFAULT_PASS=cambia-esto-rabbit

# Redis
REDIS_PASSWORD=cambia-esto-redis

# MinIO (la contraseña debe tener al menos 8 caracteres)
MINIO_ROOT_USER=empleo-minio
MINIO_ROOT_PASSWORD=cambia-esto-minio
MINIO_BUCKET_CV=cv-documents
# Usuario de servicio con el que la API guarda y borra CV. Solo tiene permisos sobre el bucket de CV
# (lo crea minio-init). La clave debe tener al menos 8 caracteres y ser distinta de la del administrador.
STORAGE_ACCESS_KEY=worksy-api
STORAGE_SECRET_KEY=cambia-esto-storage
# Dirección con la que el NAVEGADOR abre los enlaces temporales de CV (la firma incluye el host).
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000

# Autenticación de la API
# Clave para firmar los JWT: mínimo 32 caracteres aleatorios. Genera una con:
#   openssl rand -base64 48
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-32-o-mas
# true en cualquier entorno con HTTPS. Los navegadores aceptan cookies Secure en http://localhost.
AUTH_COOKIE_SECURE=true

# Dirección pública del frontend: se usa en los enlaces de los correos y en el regreso del inicio de sesión externo.
APP_PUBLIC_URL=http://localhost:5173

# Inicio de sesión con cuentas externas (OAuth 2.0 / OpenID Connect).
# Un proveedor sin ID queda desactivado. URL de regreso que hay que registrar en cada consola:
#   http://localhost:5173/api/v1/auth/oauth2/callback/<proveedor>   (google, linkedin o github)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Correo saliente (recuperar contraseña) con Gmail SMTP.
# MAIL_PASSWORD es una "contraseña de aplicación" de Google (16 letras), NO la contraseña de la cuenta.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Worksy <tu-cuenta@gmail.com>

# Puertos publicados en 127.0.0.1. Cámbialos si chocan con otros proyectos.
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8080
WORKER_HOST_PORT=8081
REALTIME_HOST_PORT=8083
INFERENCE_HOST_PORT=8000
